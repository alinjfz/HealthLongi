// Copy this file to Secrets.xcconfig and add your real API keys.
// Secrets.xcconfig is gitignored.
//
// Switch providers in AppConfig.swift → aiProvider (.glm or .openRouter)
// For OpenRouter + Bedrock BYOK: default is amazon/nova-micro-v1 with providerOnly amazon-bedrock

GLM_API_KEY = api_key
OPENROUTER_API_KEY = your_openrouter_key_here
